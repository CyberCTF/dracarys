; The lab's own inventory beside the one Isoloom writes (addresses, connection, the linux and
; windows groups): per-host variables, and the keyboard layouts (a list, so not a `vars:` entry).
[all:vars]
keyboard_layouts=["0000040C", "00000409"]

[default]
dc01 dns_domain=dc01 dict_key=dc01
srv01 dns_domain=dc01 dict_key=srv01
lx01 dict_key=lx01 ansible_connection=ssh ansible_ssh_common_args='-o StrictHostKeyChecking=no'
