; GOAD's per-host variables when Isoloom runs the lab: Isoloom's own inventory gives each
; machine its address and connection; these say which domain each machine belongs to.
[default]
dc01 dns_domain=dc01 dict_key=dc01
srv01 dns_domain=dc01 dict_key=srv01
lx01 dict_key=lx01 ansible_connection=ssh ansible_ssh_common_args='-o StrictHostKeyChecking=no'
